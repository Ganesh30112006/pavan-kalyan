# CloudBridge API configuration. Copy to .env for local development.
# Secrets (database password, SMTP password) belong in your secret store in production, not in files.

CLOUDBRIDGE_ENVIRONMENT=development
CLOUDBRIDGE_DATABASE_URL=sqlite:///./cloudbridge.db
# CLOUDBRIDGE_DATABASE_URL=postgresql+psycopg://cloudbridge:CHANGE_ME@localhost:5432/cloudbridge

# Local development: the Vite dev server calls the API on another port.
CLOUDBRIDGE_CORS_ORIGINS=http://localhost:5173
# Plain-HTTP localhost only. Must be true (the default) anywhere else.
CLOUDBRIDGE_COOKIE_SECURE=false

# CloudBridge's own AWS role (customers' IAM roles trust this principal). The AWS SDK finds its
# credentials through the standard chain: instance/task role, AWS_PROFILE, or environment.
# CLOUDBRIDGE_AWS_PRINCIPAL_ARN=arn:aws:iam::111122223333:role/cloudbridge-platform

# Google Cloud: how CloudBridge proves its identity to Google STS (none | aws | file).
# CLOUDBRIDGE_GCP_SUBJECT_TOKEN_SOURCE=aws
# CLOUDBRIDGE_GCP_TRUSTED_PRINCIPAL=principalSet://iam.googleapis.com/projects/NUMBER/locations/global/workloadIdentityPools/POOL/attribute.aws_role/arn:aws:sts::111122223333:assumed-role/cloudbridge-platform

# Azure: where CloudBridge's federated token comes from (none | aws | file). With "aws", CloudBridge calls
# sts:GetWebIdentityToken (enable IAM outbound identity federation in its AWS account). Customers' app
# registrations trust the issuer and subject below, with audience api://AzureADTokenExchange.
# CLOUDBRIDGE_AZURE_TOKEN_SOURCE=aws
# CLOUDBRIDGE_AZURE_FEDERATION_ISSUER=https://ISSUER-ID.tokens.sts.global.api.aws
# CLOUDBRIDGE_AZURE_FEDERATION_SUBJECT=arn:aws:iam::111122223333:role/cloudbridge-platform

# Roles ECS Express Mode services use in customer accounts (defaults shown).
# CLOUDBRIDGE_AWS_ECS_EXECUTION_ROLE_NAME=CloudBridgeECSExecution
# CLOUDBRIDGE_AWS_ECS_INFRASTRUCTURE_ROLE_NAME=CloudBridgeECSInfrastructure

# Development only (refused when CLOUDBRIDGE_ENVIRONMENT=production): allow alert webhooks on
# private addresses, e.g. a receiver on localhost.
# CLOUDBRIDGE_ALLOW_PRIVATE_ALERT_URLS=false

# Optional e-mail notifications (notification settings are offered only when these are set).
# CLOUDBRIDGE_SMTP_HOST=smtp.example.com
# CLOUDBRIDGE_SMTP_FROM=cloudbridge@example.com
# CLOUDBRIDGE_SMTP_USERNAME=
# CLOUDBRIDGE_SMTP_PASSWORD=
# CLOUDBRIDGE_PUBLIC_URL=https://cloudbridge.example.com
