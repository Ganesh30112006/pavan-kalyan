# Settings for the API, worker and migrations in deploy/compose.yaml (copy to deploy/cloudbridge.env).
# The compose file sets CLOUDBRIDGE_ENVIRONMENT, CLOUDBRIDGE_DATABASE_URL and CLOUDBRIDGE_LOG_FORMAT itself.
# Every variable is documented in backend/README.md and backend/.env.example. Keep this file out of git.

# The address users open (links in e-mails and alerts). Must be https:// in production.
CLOUDBRIDGE_PUBLIC_URL=https://cloudbridge.example.com

# CloudBridge's own AWS identity (customers' roles trust it). In AWS, give the host or task an IAM role; the SDK
# finds it automatically (on EC2, set the instance metadata hop limit to 2 so containers can reach it).
# CLOUDBRIDGE_AWS_PRINCIPAL_ARN=arn:aws:iam::111122223333:role/cloudbridge-platform

# Azure and AKS through AWS outbound identity federation (see backend/README.md, "CloudBridge's own identity").
# CLOUDBRIDGE_AZURE_TOKEN_SOURCE=aws
# CLOUDBRIDGE_AZURE_FEDERATION_ISSUER=https://ISSUER-ID.tokens.sts.global.api.aws
# CLOUDBRIDGE_AZURE_FEDERATION_SUBJECT=arn:aws:iam::111122223333:role/cloudbridge-platform

# Optional e-mail notifications. Put the SMTP password in your secret store and inject it as an environment
# variable rather than writing it here.
# CLOUDBRIDGE_SMTP_HOST=smtp.example.com
# CLOUDBRIDGE_SMTP_FROM=cloudbridge@example.com
# CLOUDBRIDGE_SMTP_USERNAME=
