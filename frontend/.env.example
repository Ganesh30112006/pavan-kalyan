# Base URL of the CloudBridge FastAPI backend. No secrets belong in VITE_* variables:
# everything prefixed with VITE_ is compiled into the public JavaScript bundle.
VITE_API_BASE_URL=http://localhost:8000

# Development-only simulated backend. Rejected by `npm run build` in production mode.
VITE_DEMO_MODE=false

# Optional https:// link shown as "Contact support" on error pages.
VITE_SUPPORT_URL=
